# Copy to .env.local for local runs, or enter these in Vercel > Project > Settings > Environment Variables.

# Postgres connection string from Supabase (Project Settings > Database > Connection string > "Transaction pooler").
# Leave empty locally to use the built-in database stored in ./.data.
DATABASE_URL=

# Any long random string. Signs login cookies. Required in production.
AUTH_SECRET=

# Emails that get the instructor console (comma-separated). They can use any domain.
INSTRUCTOR_EMAILS=

# Student email domains allowed to sign up (comma-separated).
ALLOWED_EMAIL_DOMAINS=cui.edu,eagles.cui.edu

# Optional: protects the scheduled job at /api/cron. Vercel sends it automatically when set.
CRON_SECRET=
